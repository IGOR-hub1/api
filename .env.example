# Firebase project ID usado pelo login da página. Ex.: meu-projeto-12345
FIREBASE_PROJECT_ID=apis-a64de

# Gere um valor aleatório com no mínimo 32 caracteres e cadastre SOMENTE na Vercel.
# Exemplo: openssl rand -base64 48
API_TOKEN_SECRET=bucetapreyabsjsk827hshs

# Duração do token entregue a quem foi autorizado (entre 15 e 24 horas).
API_TOKEN_TTL_HOURS=15

# Controle de autorização. Separe e-mails por vírgula. Contas com a custom claim
# Firebase animeApiAccess: true também são aceitas.
API_ALLOWED_EMAILS=krabelodesouza52@gmail.com

# Opcional. Origens externas que podem chamar a API pelo navegador (CORS).
# A página deste projeto já é permitida automaticamente.
API_ALLOWED_ORIGINS=https://meu-site.com,https://www.meu-site.com
